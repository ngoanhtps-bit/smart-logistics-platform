# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (client — public)
NEXT_PUBLIC_SUPABASE_URL=https://dqnnwnasojwngvrxhyun.supabase.co
# Dashboard → Settings → API: «Publishable» (sb_publishable_...) hoặc anon (eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hoặc: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard → Settings → API: «Secret» (sb_secret_...) — chỉ server, không NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Hoặc: SUPABASE_SECRET_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Auth (production)
JWT_SECRET=change-me-in-production
ENFORCE_AUTH=false

# Maps (Phase 1)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Database (Supabase / PostgreSQL)
# DATABASE_URL: pooled connection string (runtime)
# DIRECT_URL: direct connection string (Prisma schema push/migrate)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Notifications
SMTP_HOST=
ZALO_OA_TOKEN=
SMS_API_KEY=

# Email (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Logistics <noreply@yourdomain.com>
